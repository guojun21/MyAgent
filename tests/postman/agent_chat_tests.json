    {
      "name": "0. 健康检查",
      "item": [
        {
          "name": "健康检查 - 确认服务运行",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('服务状态正常', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('返回正确的服务名称', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "    pm.expect(jsonData.service).to.eql('backend_core');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. 基础聊天测试",
      "item": [
        {
          "name": "1.1 简单问候",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('响应状态码为200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('返回成功状态', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.be.oneOf(['success', 'error']);",
                  "});",
                  "",
                  "pm.test('包含响应数据', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "    pm.expect(jsonData.data.response).to.exist;",
                  "});",
                  "",
                  "pm.test('响应时间小于60秒', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"你好，请简单介绍一下你自己\",\n    \"conversation_id\": \"{{conversationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agent/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "agent", "chat"]
            }
          }
